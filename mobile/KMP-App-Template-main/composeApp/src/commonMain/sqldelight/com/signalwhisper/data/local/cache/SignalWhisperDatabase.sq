-- Cache metadata table for tracking cache freshness
CREATE TABLE CacheMetadata (
    cache_key TEXT NOT NULL PRIMARY KEY,
    cached_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL
);

-- CRUD operations for CacheMetadata
insertOrReplaceCacheMetadata:
INSERT OR REPLACE INTO CacheMetadata(cache_key, cached_at, expires_at)
VALUES (?, ?, ?);

getCacheMetadata:
SELECT * FROM CacheMetadata WHERE cache_key = ?;

deleteCacheMetadata:
DELETE FROM CacheMetadata WHERE cache_key = ?;

deleteExpiredCache:
DELETE FROM CacheMetadata WHERE expires_at < ?;

clearAllCacheMetadata:
DELETE FROM CacheMetadata;

-- ==================== User Profile Cache ====================
CREATE TABLE CachedUserProfile (
    id TEXT NOT NULL PRIMARY KEY,
    email TEXT NOT NULL,
    full_name TEXT NOT NULL,
    joined_date TEXT NOT NULL,
    subscription_type TEXT NOT NULL,
    subscription_status TEXT NOT NULL,
    plan_type TEXT,
    billing_cycle TEXT,
    next_billing_date TEXT,
    trial_ends_in INTEGER,
    renewal_frequency TEXT,
    language TEXT NOT NULL,
    notifications_enabled INTEGER NOT NULL,
    market_alerts_enabled INTEGER NOT NULL,
    theme TEXT NOT NULL,
    cached_at INTEGER NOT NULL
);

insertOrReplaceUserProfile:
INSERT OR REPLACE INTO CachedUserProfile(
    id, email, full_name, joined_date,
    subscription_type, subscription_status, plan_type, billing_cycle,
    next_billing_date, trial_ends_in, renewal_frequency,
    language, notifications_enabled, market_alerts_enabled, theme, cached_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getUserProfile:
SELECT * FROM CachedUserProfile LIMIT 1;

deleteUserProfile:
DELETE FROM CachedUserProfile;

-- ==================== Market Signals Cache ====================
CREATE TABLE CachedMarketSignal (
    id TEXT NOT NULL PRIMARY KEY,
    pair TEXT NOT NULL,
    signal_type TEXT NOT NULL,
    price_from TEXT NOT NULL,
    price_to TEXT NOT NULL,
    action TEXT NOT NULL,
    icon_letter TEXT NOT NULL,
    icon_color TEXT NOT NULL,
    action_text_color TEXT NOT NULL,
    action_bg_color TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    entry_price REAL,
    closing_price REAL,
    total_pl REAL,
    percent_return REAL,
    take_profit REAL,
    stop_loss REAL,
    confidence_score REAL,
    analyst_notes TEXT,
    generated_time TEXT,
    closed_time TEXT,
    status TEXT,
    date_group TEXT NOT NULL,
    cached_at INTEGER NOT NULL
);

insertOrReplaceMarketSignal:
INSERT OR REPLACE INTO CachedMarketSignal(
    id, pair, signal_type, price_from, price_to, action,
    icon_letter, icon_color, action_text_color, action_bg_color,
    timestamp, entry_price, closing_price, total_pl, percent_return,
    take_profit, stop_loss, confidence_score, analyst_notes,
    generated_time, closed_time, status, date_group, cached_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllMarketSignals:
SELECT * FROM CachedMarketSignal ORDER BY timestamp DESC;

getMarketSignalsByDateGroup:
SELECT * FROM CachedMarketSignal WHERE date_group = ? ORDER BY timestamp DESC;

getDistinctDateGroups:
SELECT DISTINCT date_group FROM CachedMarketSignal ORDER BY cached_at DESC;

deleteAllMarketSignals:
DELETE FROM CachedMarketSignal;

-- ==================== Insider Trading Cache ====================
CREATE TABLE CachedInsiderTrade (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    ticker TEXT NOT NULL,
    company TEXT NOT NULL,
    insider_name TEXT NOT NULL,
    insider_title TEXT NOT NULL,
    transaction_type TEXT NOT NULL,
    shares REAL NOT NULL,
    price_per_share REAL NOT NULL,
    total_value REAL NOT NULL,
    transaction_date TEXT NOT NULL,
    filing_date TEXT NOT NULL,
    form_type TEXT NOT NULL,
    sec_filing_url TEXT,
    performance REAL,
    cached_at INTEGER NOT NULL
);

CREATE INDEX idx_insider_trade_ticker ON CachedInsiderTrade(ticker);

insertInsiderTrade:
INSERT INTO CachedInsiderTrade(
    ticker, company, insider_name, insider_title, transaction_type,
    shares, price_per_share, total_value, transaction_date, filing_date,
    form_type, sec_filing_url, performance, cached_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllInsiderTrades:
SELECT * FROM CachedInsiderTrade ORDER BY filing_date DESC;

getInsiderTradesByTicker:
SELECT * FROM CachedInsiderTrade WHERE ticker = ? ORDER BY filing_date DESC;

deleteAllInsiderTrades:
DELETE FROM CachedInsiderTrade;

