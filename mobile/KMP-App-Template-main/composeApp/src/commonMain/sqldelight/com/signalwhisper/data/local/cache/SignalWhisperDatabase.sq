    donation_type TEXT NOT NULL,
    amount REAL NOT NULL,
    election_year INTEGER NOT NULL,
    filing_date TEXT NOT NULL,
    cached_at INTEGER NOT NULL
);

CREATE INDEX idx_donation_company ON CachedPoliticalDonation(company);

insertPoliticalDonation:
INSERT INTO CachedPoliticalDonation(
    company, ticker, donor_name, recipient_name, recipient_type,
    recipient_party, donation_type, amount, election_year, filing_date, cached_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

