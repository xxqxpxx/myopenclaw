    contract_id, company, ticker, agency, description, amount,
    award_type, award_date, start_date, end_date, sector, status,
    naics_code, contract_url, cached_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

