    company TEXT NOT NULL,
    recommendation TEXT NOT NULL,
    confidence REAL NOT NULL,
    reasoning TEXT NOT NULL,
    price_target REAL,
    stop_loss REAL,
    timeframe TEXT NOT NULL,
    catalysts_json TEXT,
    risks_json TEXT,
    cached_at INTEGER NOT NULL
);

CREATE INDEX idx_trade_idea_ticker ON CachedTradeIdea(ticker);

insertTradeIdea:
INSERT INTO CachedTradeIdea(
    ticker, company, recommendation, confidence, reasoning,
    price_target, stop_loss, timeframe, catalysts_json, risks_json, cached_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllTradeIdeas:
SELECT * FROM CachedTradeIdea ORDER BY cached_at DESC;

getTradeIdeasByTicker:
SELECT * FROM CachedTradeIdea WHERE ticker = ? ORDER BY cached_at DESC;

deleteAllTradeIdeas:
DELETE FROM CachedTradeIdea;

-- ==================== Subscription Pricing Cache ====================
CREATE TABLE CachedSubscriptionPricing (
    plan_type TEXT NOT NULL PRIMARY KEY,
    price REAL NOT NULL,
    currency TEXT NOT NULL,
    billing_frequency TEXT NOT NULL,
    trial_days INTEGER,
    discount INTEGER,
    original_price REAL,
    price_id TEXT NOT NULL,
    features_json TEXT NOT NULL,
    cached_at INTEGER NOT NULL
);

insertOrReplaceSubscriptionPricing:
INSERT OR REPLACE INTO CachedSubscriptionPricing(
    plan_type, price, currency, billing_frequency, trial_days,
    discount, original_price, price_id, features_json, cached_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllSubscriptionPricing:
SELECT * FROM CachedSubscriptionPricing;

getSubscriptionPricingByPlanType:
SELECT * FROM CachedSubscriptionPricing WHERE plan_type = ?;

deleteAllSubscriptionPricing:
DELETE FROM CachedSubscriptionPricing;

-- ==================== Clear All Cache ====================
clearAllCache:
DELETE FROM CacheMetadata;

-- Note: Each table has its own delete operation called separately
