    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    company TEXT NOT NULL,
    ticker TEXT,
    donor_name TEXT NOT NULL,
    recipient_name TEXT NOT NULL,
    recipient_type TEXT NOT NULL,
