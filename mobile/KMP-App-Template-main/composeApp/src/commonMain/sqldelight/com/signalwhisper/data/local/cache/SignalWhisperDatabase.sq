-- Cache metadata table for tracking cache freshness
CREATE TABLE CacheMetadata (
    cache_key TEXT NOT NULL PRIMARY KEY,
    cached_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL
);

-- CRUD operations for CacheMetadata
insertOrReplaceCacheMetadata:
INSERT OR REPLACE INTO CacheMetadata(cache_key, cached_at, expires_at)
VALUES (?, ?, ?);

getCacheMetadata:
SELECT * FROM CacheMetadata WHERE cache_key = ?;

deleteCacheMetadata:
DELETE FROM CacheMetadata WHERE cache_key = ?;

deleteExpiredCache:
DELETE FROM CacheMetadata WHERE expires_at < ?;

clearAllCacheMetadata:
DELETE FROM CacheMetadata;

-- ==================== User Profile Cache ====================
CREATE TABLE CachedUserProfile (
    id TEXT NOT NULL PRIMARY KEY,
    email TEXT NOT NULL,
    full_name TEXT NOT NULL,
    joined_date TEXT NOT NULL,
    subscription_type TEXT NOT NULL,
    subscription_status TEXT NOT NULL,
    plan_type TEXT,
    billing_cycle TEXT,
    next_billing_date TEXT,
    trial_ends_in INTEGER,
    renewal_frequency TEXT,
    language TEXT NOT NULL,
    notifications_enabled INTEGER NOT NULL,
    market_alerts_enabled INTEGER NOT NULL,
    theme TEXT NOT NULL,
    cached_at INTEGER NOT NULL
);

insertOrReplaceUserProfile:
INSERT OR REPLACE INTO CachedUserProfile(
    id, email, full_name, joined_date,
    subscription_type, subscription_status, plan_type, billing_cycle,
    next_billing_date, trial_ends_in, renewal_frequency,
    language, notifications_enabled, market_alerts_enabled, theme, cached_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getUserProfile:
SELECT * FROM CachedUserProfile LIMIT 1;

deleteUserProfile:
DELETE FROM CachedUserProfile;

-- ==================== Subscription Pricing Cache ====================
CREATE TABLE CachedSubscriptionPricing (
    plan_type TEXT NOT NULL PRIMARY KEY,
    price REAL NOT NULL,
    currency TEXT NOT NULL,
    billing_frequency TEXT NOT NULL,
    trial_days INTEGER,
    discount INTEGER,
    original_price REAL,
    price_id TEXT NOT NULL,
    features_json TEXT NOT NULL,
    cached_at INTEGER NOT NULL
);

insertOrReplaceSubscriptionPricing:
INSERT OR REPLACE INTO CachedSubscriptionPricing(
    plan_type, price, currency, billing_frequency, trial_days,
    discount, original_price, price_id, features_json, cached_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllSubscriptionPricing:
SELECT * FROM CachedSubscriptionPricing;

getSubscriptionPricingByPlanType:
SELECT * FROM CachedSubscriptionPricing WHERE plan_type = ?;

deleteAllSubscriptionPricing:
DELETE FROM CachedSubscriptionPricing;

-- ==================== Clear All Cache ====================
clearAllCache:
DELETE FROM CacheMetadata;

-- Note: Each table has its own delete operation called separately
