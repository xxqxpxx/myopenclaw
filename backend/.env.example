# === myOpenClaw Backend Environment Variables ===

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key

# OpenAI (Whisper voice transcription)
OPENAI_API_KEY=sk-your-openai-key

# E2B (Phase 4)
E2B_API_KEY=your-e2b-key
E2B_SANDBOX_TEMPLATE_ID=your_template_id_here

# Telegram (Phase B)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# WhatsApp / Meta Cloud API (Phase B)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_TOKEN=your-meta-api-token

# Google OAuth (Phase B)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# Stripe (Phase 8)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_POWER=price_...
STRIPE_PRICE_BYOK=price_...
STRIPE_PRICE_TOPUP=price_...

# Sentry
SENTRY_DSN=

# App
APP_ENV=development
APP_DEBUG=true

# CORS — comma-separated list of allowed origins; leave empty to allow all (wildcard, dev default)
# Example: CORS_ORIGINS=https://app.myopenclaw.com,https://www.myopenclaw.com
CORS_ORIGINS=
